# Copia este archivo como .env.local (ignorado por git) para cambiar el modo de datos fuera de Docker.
# En Docker se configura en docker-compose.yml. Las variables VITE_ quedan visibles en el navegador:
# nunca pongas claves aquí.
# auto (por defecto): usa la API; datos de ejemplo solo si la API no responde o la ruta no existe.
# api:  nunca usa datos de ejemplo (para probar la conexión real).
# mock: siempre usa datos de ejemplo (para presentar sin backend).
VITE_DATA_MODE=auto
