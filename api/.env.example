# Copiar como .env para ejecutar la API fuera de Docker.
# Apunta al PostgreSQL del docker-compose (puerto 5433 del equipo).
DATABASE_URL="postgresql://diagnostico:diagnostico_dev@localhost:5433/diagnostico?schema=public"
PORT=3000

# Carpeta donde se guardan los archivos subidos (relativa a la carpeta api).
STORAGE_DIR=./storage
# Organización usada mientras no exista login (la crea prisma/seed.ts).
DEMO_ORGANIZATION_SLUG=demo
# Tamaño máximo de archivo en MB.
MAX_UPLOAD_MB=10

# IA de extracción de competencias (Paso 5). Las claves solo van aquí (api/.env), nunca en el frontend ni en git.
# Sin clave, los CVs se suben igual y su análisis queda en error "IA no configurada".
# Proveedor: gemini (por defecto, plan gratis de Google) o claude (Anthropic, de pago).
EXTRACTION_PROVIDER=gemini

# Gemini: clave gratis en https://aistudio.google.com/apikey. OJO: en el plan gratis Google puede usar lo que se
# le envía para mejorar sus productos. Usar solo CVs de prueba (ver api/README.md).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Esperas (ms) antes de reintentar si Gemini está saturado. "none" = sin reintentos.
GEMINI_RETRY_DELAYS_MS=5000,15000,45000

# Claude (solo con EXTRACTION_PROVIDER=claude). Por defecto claude-haiku-5-5 (el más económico);
# alternativa si la calidad no alcanza: claude-sonnet-5-5.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# "off" deja los CVs en cola sin analizarlos (por ejemplo, para no gastar en pruebas).
EXTRACTION_WORKER=on
# Cada cuántos milisegundos se revisa si hay CVs en cola.
EXTRACTION_POLL_MS=5000
