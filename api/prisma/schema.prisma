// Modelo de datos de Diagnóstico Organizacional Inteligente — 28 tablas.
//
// Este archivo es la descripción oficial de la base para Prisma. Diseño y reglas de negocio de cada tabla:
// ../../docs/diseno-base-de-datos.md (las secciones 3.x de abajo corresponden a ese documento).
//
// Convenciones:
// - Modelos en PascalCase y campos en camelCase; @map/@@map indican el nombre real (snake_case) en PostgreSQL.
// - Las tablas de una empresa se relacionan con FK compuestas (organizationId, id): impiden mezclar empresas.
// - Todas las FK usan onDelete/onUpdate Restrict: nada se borra en cascada.
// - La base también tiene CHECK, exclusiones de fechas solapadas, índices parciales y triggers que Prisma no
//   puede expresar en este archivo. Viven en el SQL de prisma/migrations y siguen activos en la base.
// - Para cambiar la base: editar este archivo y ejecutar `pnpm db:migrate` (ver api/README.md).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================================
// 3.1 Identidad y acceso
// ======================================================================

model Organization {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  name       String    @db.VarChar(160)
  slug       String    @unique(map: "organizations_uq_1") @db.VarChar(100)
  legalName  String?   @map("legal_name") @db.VarChar(200)
  industry   String?   @db.VarChar(100)
  timezone   String    @default("America/Santiago") @db.VarChar(64)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  alerts                      Alert[]
  auditEvents                 AuditEvent[]
  departments                 Department[]
  diagnosticRuns              DiagnosticRun[]
  documents                   Document[]
  documentVersions            DocumentVersion[]
  employees                   Employee[]
  employeeSkills              EmployeeSkill[]
  evidence                    Evidence[]
  extractionRuns              ExtractionRun[]
  findingEvidence             FindingEvidence[]
  findings                    Finding[]
  members                     OrganizationMember[]
  operationalObservations     OperationalObservation[]
  positionAssignments         PositionAssignment[]
  positionResponsibilities    PositionResponsibility[]
  positions                   Position[]
  positionSkills              PositionSkill[]
  recommendations             Recommendation[]
  responsibilities            Responsibility[]
  responsibilityAssignments   ResponsibilityAssignment[]
  scenarioPositionAssignments ScenarioPositionAssignment[]
  scenarioPositions           ScenarioPosition[]
  scenarioResponsibilities    ScenarioResponsibility[]
  scenarios                   Scenario[]
  skills                      Skill[]
  skillProposals              SkillProposal[]

  @@map("organizations")
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  authSubject String    @unique(map: "users_uq_1") @map("auth_subject") @db.Uuid
  email       String    @db.VarChar(254)
  displayName String    @map("display_name") @db.VarChar(160)
  disabledAt  DateTime? @map("disabled_at") @db.Timestamptz(3)

  memberships OrganizationMember[]

  @@map("users")
}

model OrganizationMember {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  userId         String           @map("user_id") @db.Uuid
  role           MemberRole       @default(VIEWER)
  status         MembershipStatus @default(ACTIVE)

  organization                      Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_members_fk_1")
  user                              User                       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organization_members_fk_2")
  approvedScenarios                 Scenario[]                 @relation("ScenarioApprovedBy")
  auditEvents                       AuditEvent[]
  createdScenarios                  Scenario[]                 @relation("ScenarioCreatedBy")
  decidedRecommendations            Recommendation[]
  receivedAlerts                    Alert[]
  recordedEvidence                  Evidence[]
  recordedObservations              OperationalObservation[]
  recordedResponsibilityAssignments ResponsibilityAssignment[]
  requestedDiagnosticRuns           DiagnosticRun[]
  reviewedFindings                  Finding[]
  uploadedDocumentVersions          DocumentVersion[]
  verifiedEmployeeSkills            EmployeeSkill[]
  reviewedSkillProposals            SkillProposal[]

  @@unique([organizationId, id], map: "organization_members_org_id_key")
  @@unique([organizationId, userId], map: "organization_members_uq_1")
  @@index([userId], map: "organization_members_fk_idx_2")
  @@index([userId, status], map: "organization_members_user_status_idx")
  @@map("organization_members")
}

// ======================================================================
// 3.2 Estructura real y asignaciones
// ======================================================================

model Department {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  code               String    @db.VarChar(40)
  name               String    @db.VarChar(160)
  description        String?
  parentDepartmentId String?   @map("parent_department_id") @db.Uuid
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(3)

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "departments_fk_3")
  parentDepartment        Department?              @relation("DepartmentParentDepartment", fields: [organizationId, parentDepartmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "departments_fk_4")
  childDepartments        Department[]             @relation("DepartmentParentDepartment")
  diagnosticRuns          DiagnosticRun[]
  findings                Finding[]
  operationalObservations OperationalObservation[]
  positions               Position[]
  responsibilities        Responsibility[]
  scenarioPositions       ScenarioPosition[]

  @@unique([organizationId, id], map: "departments_org_id_key")
  @@unique([organizationId, code], map: "departments_uq_1")
  @@index([organizationId, parentDepartmentId], map: "departments_fk_idx_4")
  @@map("departments")
}

model Position {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  code             String    @db.VarChar(40)
  title            String    @db.VarChar(160)
  description      String?
  departmentId     String    @map("department_id") @db.Uuid
  parentPositionId String?   @map("parent_position_id") @db.Uuid
  targetHeadcount  Int       @default(1) @map("target_headcount")
  criticality      Severity  @default(MEDIUM)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)

  organization             Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "positions_fk_5")
  department               Department               @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "positions_fk_6")
  parentPosition           Position?                @relation("PositionParentPosition", fields: [organizationId, parentPositionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "positions_fk_7")
  documents                Document[]
  findings                 Finding[]
  operationalObservations  OperationalObservation[]
  positionAssignments      PositionAssignment[]
  positionResponsibilities PositionResponsibility[]
  positionSkills           PositionSkill[]
  scenarioPositions        ScenarioPosition[]
  subordinatePositions     Position[]               @relation("PositionParentPosition")

  @@unique([organizationId, id], map: "positions_org_id_key")
  @@unique([organizationId, code], map: "positions_uq_1")
  @@index([organizationId, departmentId, archivedAt], map: "positions_department_active_idx")
  @@index([organizationId, departmentId], map: "positions_fk_idx_6")
  @@index([organizationId, parentPositionId], map: "positions_fk_idx_7")
  @@map("positions")
}

model Employee {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  employeeCode        String?        @map("employee_code") @db.VarChar(60)
  fullName            String         @map("full_name") @db.VarChar(200)
  email               String?        @db.VarChar(254)
  weeklyCapacityHours Decimal?       @map("weekly_capacity_hours") @db.Decimal(6, 2)
  status              EmployeeStatus @default(ACTIVE)
  archivedAt          DateTime?      @map("archived_at") @db.Timestamptz(3)

  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "employees_fk_8")
  documents                   Document[]
  employeeSkills              EmployeeSkill[]
  findings                    Finding[]
  operationalObservations     OperationalObservation[]
  positionAssignments         PositionAssignment[]
  responsibilityAssignments   ResponsibilityAssignment[]
  scenarioPositionAssignments ScenarioPositionAssignment[]
  skillProposals              SkillProposal[]

  @@unique([organizationId, id], map: "employees_org_id_key")
  @@unique([organizationId, employeeCode], map: "employees_uq_1")
  @@index([organizationId, status, fullName], map: "employees_directory_idx")
  @@map("employees")
}

model PositionAssignment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  employeeId        String    @map("employee_id") @db.Uuid
  positionId        String    @map("position_id") @db.Uuid
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  allocationPercent Decimal   @default(100) @map("allocation_percent") @db.Decimal(5, 2)
  notes             String?

  employee     Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "position_assignments_fk_10")
  position     Position     @relation(fields: [organizationId, positionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "position_assignments_fk_11")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "position_assignments_fk_9")

  @@unique([organizationId, id], map: "position_assignments_org_id_key")
  @@index([organizationId, employeeId, startDate], map: "position_assignments_employee_date_idx")
  @@index([organizationId, employeeId], map: "position_assignments_fk_idx_10")
  @@index([organizationId, positionId], map: "position_assignments_fk_idx_11")
  @@index([organizationId, positionId, startDate], map: "position_assignments_position_date_idx")
  @@map("position_assignments")
}

// ======================================================================
// 3.3 Funciones esperadas y efectivas
// ======================================================================

model Responsibility {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  code           String    @db.VarChar(60)
  name           String    @db.VarChar(160)
  description    String?
  departmentId   String?   @map("department_id") @db.Uuid
  criticality    Severity  @default(MEDIUM)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "responsibilities_fk_12")
  department                Department?                @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "responsibilities_fk_13")
  findings                  Finding[]
  positionResponsibilities  PositionResponsibility[]
  responsibilityAssignments ResponsibilityAssignment[]
  scenarioResponsibilities  ScenarioResponsibility[]

  @@unique([organizationId, id], map: "responsibilities_org_id_key")
  @@unique([organizationId, code], map: "responsibilities_uq_1")
  @@index([organizationId, departmentId], map: "responsibilities_fk_idx_13")
  @@map("responsibilities")
}

model PositionResponsibility {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  positionId          String             @map("position_id") @db.Uuid
  responsibilityId    String             @map("responsibility_id") @db.Uuid
  assignmentRole      ResponsibilityRole @map("assignment_role")
  expectedWeeklyHours Decimal?           @map("expected_weekly_hours") @db.Decimal(6, 2)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "position_responsibilities_fk_14")
  position       Position       @relation(fields: [organizationId, positionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "position_responsibilities_fk_15")
  responsibility Responsibility @relation(fields: [organizationId, responsibilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "position_responsibilities_fk_16")

  @@unique([organizationId, id], map: "position_responsibilities_org_id_key")
  @@unique([organizationId, positionId, responsibilityId], map: "position_responsibilities_uq_1")
  @@index([organizationId, responsibilityId], map: "position_responsibilities_fk_idx_16")
  @@map("position_responsibilities")
}

model ResponsibilityAssignment {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  employeeId         String             @map("employee_id") @db.Uuid
  responsibilityId   String             @map("responsibility_id") @db.Uuid
  assignmentRole     ResponsibilityRole @map("assignment_role")
  actualWeeklyHours  Decimal?           @map("actual_weekly_hours") @db.Decimal(6, 2)
  startDate          DateTime           @map("start_date") @db.Date
  endDate            DateTime?          @map("end_date") @db.Date
  evidenceId         String?            @map("evidence_id") @db.Uuid
  recordedByMemberId String?            @map("recorded_by_member_id") @db.Uuid

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "responsibility_assignments_fk_17")
  employee       Employee            @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "responsibility_assignments_fk_18")
  responsibility Responsibility      @relation(fields: [organizationId, responsibilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "responsibility_assignments_fk_19")
  evidence       Evidence?           @relation(fields: [organizationId, evidenceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "responsibility_assignments_fk_20")
  recordedBy     OrganizationMember? @relation(fields: [organizationId, recordedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "responsibility_assignments_fk_21")

  @@unique([organizationId, id], map: "responsibility_assignments_org_id_key")
  @@index([organizationId, employeeId, startDate], map: "responsibility_assignments_employee_date_idx")
  @@index([organizationId, employeeId], map: "responsibility_assignments_fk_idx_18")
  @@index([organizationId, responsibilityId], map: "responsibility_assignments_fk_idx_19")
  @@index([organizationId, evidenceId], map: "responsibility_assignments_fk_idx_20")
  @@index([organizationId, recordedByMemberId], map: "responsibility_assignments_fk_idx_21")
  @@index([organizationId, responsibilityId, startDate], map: "responsibility_assignments_function_date_idx")
  @@map("responsibility_assignments")
}

// ======================================================================
// 3.4 Competencias
// ======================================================================

model Skill {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  code           String        @db.VarChar(80)
  name           String        @db.VarChar(160)
  category       SkillCategory
  description    String?
  archivedAt     DateTime?     @map("archived_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "skills_fk_22")
  employeeSkills EmployeeSkill[]
  findings       Finding[]
  positionSkills PositionSkill[]
  skillProposals SkillProposal[]

  @@unique([organizationId, id], map: "skills_org_id_key")
  @@unique([organizationId, code], map: "skills_uq_1")
  @@map("skills")
}

model PositionSkill {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  positionId     String   @map("position_id") @db.Uuid
  skillId        String   @map("skill_id") @db.Uuid
  requiredLevel  Int?     @map("required_level")
  isMandatory    Boolean  @default(true) @map("is_mandatory")
  weight         Decimal  @default(1) @db.Decimal(5, 2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "position_skills_fk_23")
  position     Position     @relation(fields: [organizationId, positionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "position_skills_fk_24")
  skill        Skill        @relation(fields: [organizationId, skillId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "position_skills_fk_25")

  @@unique([organizationId, id], map: "position_skills_org_id_key")
  @@unique([organizationId, positionId, skillId], map: "position_skills_uq_1")
  @@index([organizationId, skillId], map: "position_skills_fk_idx_25")
  @@map("position_skills")
}

model EmployeeSkill {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  employeeId         String             @map("employee_id") @db.Uuid
  skillId            String             @map("skill_id") @db.Uuid
  level              Int?
  verificationStatus VerificationStatus @default(DECLARED) @map("verification_status")
  evidenceId         String?            @map("evidence_id") @db.Uuid
  verifiedByMemberId String?            @map("verified_by_member_id") @db.Uuid
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "employee_skills_fk_26")
  employee     Employee            @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "employee_skills_fk_27")
  skill        Skill               @relation(fields: [organizationId, skillId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "employee_skills_fk_28")
  evidence     Evidence?           @relation(fields: [organizationId, evidenceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "employee_skills_fk_29")
  verifiedBy   OrganizationMember? @relation(fields: [organizationId, verifiedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "employee_skills_fk_30")

  @@unique([organizationId, id], map: "employee_skills_org_id_key")
  @@unique([organizationId, employeeId, skillId], map: "employee_skills_uq_1")
  @@index([organizationId, skillId], map: "employee_skills_fk_idx_28")
  @@index([organizationId, evidenceId], map: "employee_skills_fk_idx_29")
  @@index([organizationId, verifiedByMemberId], map: "employee_skills_fk_idx_30")
  @@map("employee_skills")
}

// ======================================================================
// 3.5 Documentos y procesamiento
// ======================================================================

model Document {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  title          String       @db.VarChar(200)
  type           DocumentType
  employeeId     String?      @map("employee_id") @db.Uuid
  positionId     String?      @map("position_id") @db.Uuid
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "documents_fk_31")
  employee     Employee?         @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "documents_fk_32")
  position     Position?         @relation(fields: [organizationId, positionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "documents_fk_33")
  versions     DocumentVersion[]

  @@unique([organizationId, id], map: "documents_org_id_key")
  @@index([organizationId, employeeId], map: "documents_fk_idx_32")
  @@index([organizationId, positionId], map: "documents_fk_idx_33")
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "documents_list_idx")
  @@map("documents")
}

model DocumentVersion {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  documentId         String       @map("document_id") @db.Uuid
  versionNumber      Int          @map("version_number")
  originalName       String       @map("original_name") @db.VarChar(255)
  storageKey         String       @unique(map: "document_versions_uq_1") @map("storage_key") @db.VarChar(500)
  mimeType           String       @map("mime_type") @db.VarChar(100)
  sizeBytes          BigInt       @map("size_bytes")
  sha256             String?      @db.VarChar(64)
  uploadStatus       UploadStatus @default(PENDING_UPLOAD) @map("upload_status")
  uploadedByMemberId String       @map("uploaded_by_member_id") @db.Uuid
  uploadedAt         DateTime?    @map("uploaded_at") @db.Timestamptz(3)
  purgedAt           DateTime?    @map("purged_at") @db.Timestamptz(3)

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "document_versions_fk_34")
  document       Document           @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "document_versions_fk_35")
  uploadedBy     OrganizationMember @relation(fields: [organizationId, uploadedByMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "document_versions_fk_36")
  evidence       Evidence[]
  extractionRuns ExtractionRun[]

  @@unique([organizationId, id], map: "document_versions_org_id_key")
  @@unique([organizationId, documentId, versionNumber], map: "document_versions_uq_2")
  @@index([organizationId, uploadedByMemberId], map: "document_versions_fk_idx_36")
  @@index([organizationId, sha256], map: "document_versions_hash_idx")
