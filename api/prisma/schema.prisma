  scenario         Scenario         @relation(fields: [organizationId, scenarioId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "scenario_position_assignments_fk_75")
  employee         Employee         @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "scenario_position_assignments_fk_76")
  scenarioPosition ScenarioPosition @relation(fields: [organizationId, scenarioId, scenarioPositionId], references: [organizationId, scenarioId, id], onDelete: Restrict, onUpdate: Restrict, map: "scenario_position_assignments_fk_87")

  @@unique([organizationId, id], map: "scenario_position_assignments_org_id_key")
  @@unique([organizationId, scenarioId, scenarioPositionId, employeeId], map: "scenario_position_assignments_uq_1")
  @@index([organizationId, employeeId], map: "scenario_position_assignments_fk_idx_76")
  @@map("scenario_position_assignments")
}

model ScenarioResponsibility {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String             @map("organization_id") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  scenarioId             String             @map("scenario_id") @db.Uuid
  sourceResponsibilityId String?            @map("source_responsibility_id") @db.Uuid
  scenarioPositionId     String?            @map("scenario_position_id") @db.Uuid
  name                   String             @db.VarChar(160)
  description            String?
  criticality            Severity
  assignmentRole         ResponsibilityRole @map("assignment_role")
  expectedWeeklyHours    Decimal?           @map("expected_weekly_hours") @db.Decimal(6, 2)
  changeType             ScenarioChangeType @map("change_type")

  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "scenario_responsibilities_fk_77")
  scenario             Scenario          @relation(fields: [organizationId, scenarioId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "scenario_responsibilities_fk_78")
  sourceResponsibility Responsibility?   @relation(fields: [organizationId, sourceResponsibilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "scenario_responsibilities_fk_79")
  scenarioPosition     ScenarioPosition? @relation(fields: [organizationId, scenarioId, scenarioPositionId], references: [organizationId, scenarioId, id], onDelete: Restrict, onUpdate: Restrict, map: "scenario_responsibilities_fk_88")

  @@unique([organizationId, id], map: "scenario_responsibilities_org_id_key")
  @@index([organizationId, scenarioId], map: "scenario_responsibilities_fk_idx_78")
  @@index([organizationId, sourceResponsibilityId], map: "scenario_responsibilities_fk_idx_79")
  @@index([organizationId, scenarioId, scenarioPositionId], map: "scenario_responsibilities_fk_idx_88")
  @@map("scenario_responsibilities")
}

// ======================================================================
// 3.9 Alertas y auditoría
// ======================================================================

model Alert {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  findingId         String    @map("finding_id") @db.Uuid
  recipientMemberId String    @map("recipient_member_id") @db.Uuid
  readAt            DateTime? @map("read_at") @db.Timestamptz(3)
  acknowledgedAt    DateTime? @map("acknowledged_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "alerts_fk_80")
  finding      Finding            @relation(fields: [organizationId, findingId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "alerts_fk_81")
  recipient    OrganizationMember @relation(fields: [organizationId, recipientMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "alerts_fk_82")

  @@unique([organizationId, id], map: "alerts_org_id_key")
  @@unique([organizationId, findingId, recipientMemberId], map: "alerts_uq_1")
  @@index([organizationId, recipientMemberId], map: "alerts_fk_idx_82")
  @@map("alerts")
}

/// Append-only: un trigger de la base rechaza UPDATE y DELETE.
model AuditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actorMemberId  String?  @map("actor_member_id") @db.Uuid
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String?  @map("entity_id") @db.Uuid
  requestId      String?  @map("request_id") @db.VarChar(100)
  changes        Json?
  metadata       Json?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_events_fk_83")
  actor        OrganizationMember? @relation(fields: [organizationId, actorMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "audit_events_fk_84")

  @@unique([organizationId, id], map: "audit_events_org_id_key")
  @@index([organizationId, entityType, entityId, createdAt], map: "audit_events_entity_idx")
  @@index([organizationId, actorMemberId], map: "audit_events_fk_idx_84")
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "audit_events_history_idx")
  @@map("audit_events")
}

